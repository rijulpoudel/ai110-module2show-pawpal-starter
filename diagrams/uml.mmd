classDiagram
    class Task {
        +str title
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +str pet_name
        +bool completed
        +mark_complete() Task
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task) None
        +task_count() int
    }

    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet) None
        +all_tasks() List~Task~
        +get_pet(name) Pet
    }

    class Scheduler {
        +Owner owner
        +sort_by_time(tasks) List~Task~
        +filter_tasks(tasks, pet_name, completed) List~Task~
        +detect_conflicts(tasks) List~str~
        +build_daily_plan() List~Task~
        +complete_task(task) Task
    }

    Owner "1" --> "many" Pet : has
    Pet "1" --> "many" Task : has
    Scheduler "1" --> "1" Owner : reads tasks from
